@model List<Note>

@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Notes</h1>
        <p class="text-muted mb-0">
            @(Model?.Count ?? 0) notes saved
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Add a note</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width: 4rem">#</th>
            <th>Title</th>
            <th>Body</th>
            <th>Created</th>
            <th style="width: 10rem"></th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var n in Model)
            {
                <tr>
                    <td class="text-end">@n.NoteId</td>
                    <td>@n.Title</td>
                    <td>@(n.Body ?? "—")</td>
                    <td>@n.CreatedOn.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@n.NoteId"
                           class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@n.NoteId"
                           class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No notes found.
                </td>
            </tr>
        }
    </tbody>
</table>